node_modules/
__pycache__/
*.pyc
*.sql.bak
sa-key.json
.pytest_cache/
.venv/

# All dotenv files are ignored except the checked-in example.
.env*
!.env.example

# Terraform working-directory state, not the lock files (those are
# committed on purpose to pin exact provider versions/checksums).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# archive_file build output (infra/terraform/prod/uptime.tf) — rebuilt
# from uptime/handler.py on every plan/apply, not something to track.
infra/terraform/prod/.build/
