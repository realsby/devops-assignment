# Copy to .env for local runs. Real values live in the deploy target's
# secret manager (env vars / Secrets Manager / etc.), never in git. All
# committed secrets in this repo's history are treated as burned.

# Standard postgres connection URL, read by both portal and notifier.
# Put sslmode in the URL when pointing at Neon or similar.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wellis

# --- portal ---
PORT=8080

# Comma-separated name:sha256hex pairs, one per person/service — named
# tokens so lookups are attributable to someone, not one shared secret.
# Generate a hash with:
#   printf '%s' 'your-token' | shasum -a 256
API_TOKENS=care-team:REPLACE_WITH_SHA256_HEX_OF_YOUR_TOKEN

# --- notifier ---
# Leave MESSAGING_URL empty to run the notifier in dry-run mode (it logs
# what it would send and marks reminders sent, instead of calling out).
MESSAGING_URL=
MESSAGING_KEY=

# S3 bucket for send receipts (id/channel/status/timestamp only, no PII).
# Leave empty to skip writing receipts entirely. No default — an unset
# bucket must never fall back to a real one.
RECEIPT_BUCKET=
